# Copy to .env (git-ignored). Never commit real values.
#
# The repo URL + PAT are NOT set by hand: connecting a repo (UI or POST /api/validate-and-clone)
# writes them to .env as, for https://github.com/acme/golden:
#   ASTRA_REPO_ACME__GOLDEN_URL=https://github.com/acme/golden
#   ASTRA_REPO_ACME__GOLDEN_TOKEN=ghp_replace_me
# Rule: ASTRA_REPO_<OWNER>__<NAME>_{URL,TOKEN}, uppercased, non-alphanumerics -> "_".
# The W2 tool looks a repo up by its owner + name using this rule, so you may also add the pair by hand.
ASTRA_REPO_ACME__GOLDEN_URL=https://github.com/acme/golden
ASTRA_REPO_ACME__GOLDEN_TOKEN=ghp_replace_me

# Optional overrides
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# FASTEMBED_CACHE_DIR=.cache/fastembed

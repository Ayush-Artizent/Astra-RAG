# Copy to .env for local development. NEVER commit real secrets.
# In Azure, every secret below comes from Key Vault via workload identity.

ASTRA_ENV=local
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_JSON=false

# --- State / graph (docker compose up -d) ---
ASTRA_POSTGRES_DSN=postgresql://astra:astra@localhost:5432/astra

# --- Blob snapshots (Azurite, from docker compose) ---
ASTRA_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
ASTRA_BLOB_SNAPSHOT_CONTAINER=snapshots

# --- Queue (leave empty locally -> in-memory queue) ---
ASTRA_SERVICEBUS_CONNECTION_STRING=

# --- Pluggable backends: memory | azure_ai_search | pgvector, fake | azure_openai, ... ---
ASTRA_CHUNK_STORE=memory
ASTRA_GRAPH_STORE=memory
ASTRA_EMBEDDER=fake
ASTRA_RERANKER=passthrough

# --- Azure OpenAI (model policy is still an open [DECISION]; see docs/decisions.md) ---
ASTRA_AZURE_OPENAI_ENDPOINT=
ASTRA_AZURE_OPENAI_API_KEY=
ASTRA_AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Azure AI Search ---
ASTRA_AZURE_SEARCH_ENDPOINT=
ASTRA_AZURE_SEARCH_API_KEY=

# --- rag-api auth (local only; prod uses Entra ID) ---
ASTRA_AUTH_MODE=api_key
ASTRA_API_KEYS_JSON={"dev-key-tenant-a": "t_dev_a", "dev-key-tenant-b": "t_dev_b"}
ASTRA_SEED_DEMO_DATA=true

# --- rag-ingest webhooks (local only) ---
ASTRA_WEBHOOK_SECRETS_JSON={"t_dev_a": "local-webhook-secret"}
ASTRA_DEBOUNCE_SECONDS=180

# --- rag-mcp / rag-eval / SDK clients ---
ASTRA_API_URL=http://localhost:8080
ASTRA_API_TOKEN=dev-key-tenant-a

    "fastify": "5.2.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.0",
    "@types/node": "22.10.7",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}

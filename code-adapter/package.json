{
  "name": "astra-code-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASTRA RAGaaS code plane: HTTP adapter around CodeGraph",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
